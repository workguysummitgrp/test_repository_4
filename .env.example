# =============================================================================
# AI-Powered Customer Onboarding Portal — Local Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# DO NOT commit .env to version control.
# =============================================================================

# -- Database ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://onboard:onboard@db:5432/onboarding
# Use localhost instead of db when running outside Docker:
# DATABASE_URL=postgresql+asyncpg://onboard:onboard@localhost:5432/onboarding
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# -- PostgreSQL Container ------------------------------------------------------
POSTGRES_USER=onboard
POSTGRES_PASSWORD=onboard
POSTGRES_DB=onboarding

# -- JWT / Auth ----------------------------------------------------------------
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
OTP_EXPIRY_SECONDS=60
MAX_OTP_ATTEMPTS=5
LOCKOUT_MINUTES=15

# -- OpenAI (REQUIRED) --------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_RETRIES=3

# -- Application ---------------------------------------------------------------
APP_NAME=AI-Powered Customer Onboarding Portal
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# -- AWS (optional for local — services degrade gracefully) --------------------
AWS_REGION=us-east-1
S3_BUCKET_NAME=onboarding-documents
S3_PRESIGNED_EXPIRY=3600
SES_SENDER_EMAIL=noreply@example.com
SNS_TOPIC_ARN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# -- Upload Limits -------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760

# -- Frontend ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
